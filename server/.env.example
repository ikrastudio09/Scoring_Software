# Copy to server/.env (never commit .env). Every variable is read in server/src/config/env.js.
NODE_ENV=production
PORT=4000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/cricket
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=14h
# Comma-separated origins allowed to call the API from other domains (the Android app's
# https://localhost origin is always allowed). Leave empty when everything is same-origin.
CORS_ORIGINS=
# Number of reverse proxies in front of Node (nginx = 1). Needed for correct client IPs.
TRUST_PROXY=1
LOG_LEVEL=info
SERVE_STATIC=true
# First boot only: creates this admin if the database has no users. Remove afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TOURNAMENT_NAME=Cricket Tournament
# Per-IP limits. Venue Wi-Fi puts many phones behind one IP: keep the public limit generous.
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_PUBLIC_PER_MIN=600
# Backups (npm run backup)
BACKUP_DIR=/var/backups/cricket
BACKUP_KEEP=60
