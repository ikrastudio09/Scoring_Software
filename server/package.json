{
  "name": "@cricket/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "test": "vitest run",
    "test:engine": "vitest run test/engine",
    "test:watch": "vitest",
    "seed": "node --env-file=.env scripts/seed.js",
    "import": "node --env-file=.env scripts/import-tournament.js",
    "stats:rebuild": "node --env-file=.env scripts/rebuild-stats.js",
    "backup": "node --env-file=.env scripts/backup.js",
    "verify:matches": "node --env-file=.env scripts/verify-matches.js",
    "create-user": "node --env-file=.env scripts/create-user.js"
  },
  "dependencies": {
    "@cricket/shared": "*",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "pino": "^9.14.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
