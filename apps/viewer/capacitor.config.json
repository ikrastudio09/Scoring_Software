{
  "appId": "com.cricketscoring.tournament",
  "appName": "Live Cricket",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": false,
      "backgroundColor": "#0f766e",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
